{
  "name": "valquiria-chat-desktop",
  "version": "1.0.0",
  "description": "Aplicação de ambiente de trabalho do Valquíria Chat (wrapper Electron)",
  "main": "main.js",
  "author": "Valquíria Chat",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.valquiria.chat",
    "productName": "Valquiria Chat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "settings.html",
      "offline.html",
      "build/**/*"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network"
    }
  }
}
