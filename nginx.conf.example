# Exemplo de configuração do Nginx como proxy reverso para o Valquíria Chat
# num VPS próprio (Ubuntu/Debian, etc). NÃO é necessário no Railway — o
# Railway já trata do domínio público e do TLS automaticamente.
#
# Uso:
#   1. Copia este ficheiro para /etc/nginx/sites-available/valquiria-chat
#   2. sudo ln -s /etc/nginx/sites-available/valquiria-chat /etc/nginx/sites-enabled/
#   3. sudo nginx -t && sudo systemctl reload nginx
#   4. (Recomendado) usa o Certbot para HTTPS: sudo certbot --nginx -d teudominio.com

server {
    listen 80;
    server_name teudominio.com;

    # Backend Node.js (que também serve o build do frontend em produção)
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Socket.IO precisa de suporte explícito a WebSocket (upgrade acima já cobre isto,
    # mas mantemos a rota explícita para clareza)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    client_max_body_size 20M;
}
