# ---- Valquiria Chat — variáveis de ambiente (produção / Docker / Railway) ----

# Porta em que o backend (e o frontend estático) vai correr
PORT=4000

# Segredo do JWT — troca por um valor longo e aleatório em produção
JWT_SECRET=troca_este_segredo_por_algo_muito_seguro
JWT_EXPIRES_IN=7d

# Credenciais do painel administrativo (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Origem permitida para CORS. Em deploy single-service (Railway) normalmente
# é o mesmo domínio público da aplicação.
CLIENT_URL=http://localhost:4000

# Limite de upload em MB (usado pelo multer)
MAX_UPLOAD_MB=15

NODE_ENV=production
